flowchart TD
    classDef client fill:#f0f9ff,stroke:#0284c7,stroke-width:2px,color:#0369a1;
    classDef check fill:#fff1f2,stroke:#f43f5e,stroke-width:2px,color:#881337;
    classDef storage fill:#ecfdf5,stroke:#10b981,stroke-width:2px,color:#064e3b;
    classDef db fill:#fffbeb,stroke:#f59e0b,stroke-width:2px,color:#78350f;
    classDef success fill:#f0fdf4,stroke:#22c55e,stroke-width:2.5px,color:#14532d;

    U["Admin uploads file"]:::client --> V["API Pre-flight Validation"]:::check
    V -->|MIME & Magic Bytes| T["MIME Allowlist<br/>(JPEG, PNG, WebP, PDF)"]:::check
    V -->|File Size Limits| S["Size Limits<br/>(Images <= 10MB, PDF <= 50MB)"]:::check
    V -->|RBAC Guard| P["Permission Guard<br/>(media.upload)"]:::check

    T --> G["Generate Storage Key<br/>(media-type/YYYY/MM/UUID.ext)"]:::storage
    S --> G
    P --> G

    G --> PUT["Stream Binary Object to MinIO"]:::storage
    PUT --> SHA["Compute SHA-256 & Dimensions"]:::storage
    SHA --> DB["INSERT into media_assets<br/>(bucket, storage_key, checksum)"]:::db
    DB --> TX["INSERT into media_translations<br/>(alt_text, caption per locale)"]:::db
    TX --> RET["Return MediaAsset DTO"]:::success
