# Read by `docker compose -f compose.production.yml`. Copy to `.env` on the server.
#
# NEXT_PUBLIC_API_URL is a BUILD arg, not a runtime one: Next inlines NEXT_PUBLIC_* into the
# client bundle. Changing it requires rebuilding the site images, not just restarting them.
#
# api.ttu.edu.vn and admin.ttu.edu.vn already belong to the sibling ttu-web-platform repo
# (the seven faculty sites + their API) — this repo's containers use the platform- prefix so
# both repos' Nginx vhosts can coexist on the same server.
COMPOSE_PROJECT_NAME=ttu-platform

NEXT_PUBLIC_API_URL=https://platform-api.ttu.edu.vn/api/v1
