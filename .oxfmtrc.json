{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "printWidth": 100,
  "arrowParens": "always",
  "sortPackageJson": false,
  "proseWrap": "never",
  "jsdoc": true,
  "ignorePatterns": [
    "node_modules",
    ".next",
    "dist",
    "coverage",
    ".moon",
    "bun.lock",
    "next-env.d.ts"
  ]
}
