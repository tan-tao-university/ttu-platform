{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "ignoreBinaries": ["moon", "make"],
  "workspaces": {
    ".": {},
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/db/index.ts",
        "src/access/decorators/require-permission.decorator.ts",
        "test/**/*.ts",
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      // Loaded by pino as a worker-thread transport via the string target
      // `common/logging/logger.module.ts` passes it, never a static import — knip can't see that.
      "ignoreDependencies": ["pino-pretty"],
    },
    "apps/admin": {
      "next": true,
      "project": ["src/**/*.{ts,tsx,css}"],
    },
    "apps/web": {
      "next": true,
      "project": ["src/**/*.{ts,tsx,css}"],
    },
    "packages/cms-registry": {
      "project": ["src/**/*.ts"],
    },
  },
}
