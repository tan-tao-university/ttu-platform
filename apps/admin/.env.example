# TTU content management dashboard (ttu.edu.vn)
# Copy to `.env.local` for local development.

# Public API URL, called server-side (GET /api/v1/admin/me, and every future admin.* call)
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

# Public site URL — the "Xem website" link in the header
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ttu-identity's Keycloak realm (see ../../ttu-identity, sibling repo) and the ttu-web client
# registered there. Server-only — the browser is redirected via a 302, never given these values.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/ttu
KEYCLOAK_CLIENT_ID=ttu-web

# This app's own base URL — fixed, not derived from the request's Host header, so the
# Authorization Code + PKCE redirect_uri stays exactly what ttu-web's redirectUris allowlists.
APP_BASE_URL=http://localhost:3011

# High-entropy random value, never a passphrase — encrypts the session/OIDC-transaction cookies.
# Generate a real one for every environment: `openssl rand -base64 32`. This dev value is not
# secret and must never be reused anywhere real.
SESSION_SECRET=dev-only-CHANGE-ME-3f8a1c9d2b7e4f6a0c5d8b1e3f7a9c2d

# Node environment (development | production | test)
NODE_ENV=development
