# Minimal for now — DATABASE_URL, Keycloak, and MinIO settings get added once the CMS's
# domain model (ttu_main schema) and auth flow are actually designed. See ../ttu-data-infra
# and ../ttu-identity for the shared infrastructure this app will eventually connect to.
NODE_ENV=development
PORT=4001

# Comma-separated. In production list the public site and admin dashboard origins.
CORS_ORIGINS=*
