# DATABASE_URL points at ttu-data-infra's ttu_main database — see ../ttu-data-infra's
# env/dev.env.example (TTU_DB_USER/TTU_DB_PASSWORD) and docs/setup.md here for how the two
# repos are wired together locally.
NODE_ENV=development
PORT=4001

# Comma-separated. In production list the public site and admin dashboard origins.
CORS_ORIGINS=*

# Pino log level — trace|debug|info|warn|error|fatal|silent. Pretty-printed in every NODE_ENV
# except production, which ships plain NDJSON to stdout for log aggregation.
LOG_LEVEL=info

# postgresql://<user>:<password>@127.0.0.1:5432/ttu_main — ttu-data-infra publishes Postgres
# on 127.0.0.1 in dev (see its compose.dev.yaml); apps/api connects as a natively-run host
# process, not a container on the ttu-backend network.
DATABASE_URL=postgresql://ttu_user:ttu_dev_password@127.0.0.1:5432/ttu_main
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_IDLE_TIMEOUT_SECONDS=20
DB_MAX_LIFETIME_SECONDS=1800

# Points at ttu-identity's Keycloak realm (see ../ttu-identity, sibling repo). Both the
# token issuer JwtAuthGuard requires and the base URL it derives the JWKS endpoint from.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/ttu
# The realm client every access token must have been issued for (checked against `azp`) —
# see ../ttu-identity's `ttu-web` client.
KEYCLOAK_CLIENT_ID=ttu-web

# ttu-data-infra provisions one public bucket (ttu-media, anonymous-download policy) and a
# scoped app-readwrite credential — never the MINIO_ROOT_USER/PASSWORD pair. See
# ../ttu-data-infra's env/dev.env.example (MINIO_APP_ACCESS_KEY/MINIO_APP_SECRET_KEY) and
# minio/init/create-buckets.sh for how the bucket and credential are provisioned.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=ttu-media
S3_ACCESS_KEY=ttu-app
S3_SECRET_KEY=ttu_app_dev_secret
# Public read origin, if different from S3_ENDPOINT (e.g. a CDN/reverse-proxy domain in
# production). Defaults to S3_ENDPOINT when unset — fine for direct MinIO in dev.
# S3_PUBLIC_URL_BASE=
